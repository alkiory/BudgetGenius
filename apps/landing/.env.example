# Leave empty when the landing and the SPA share an origin (default deploy:
# landing at /, SPA at /app/). Set it only when the app lives on its own host,
# e.g. PUBLIC_APP_URL=https://app.budgetgenius.com
PUBLIC_APP_URL=

# Android APK (GitHub Releases). Leave empty to download the newest stable
# build through the release workflow's stable `BudgetGenius.apk` alias; the
# build probes that URL and falls back to the release page while the alias does
# not exist yet, so an early deploy never ships a 404.
# Pin a version only if you deliberately want the button frozen:
# PUBLIC_APK_URL=https://github.com/alkiory/BudgetGenius/releases/download/v1.11.0/BudgetGenius-v1.11.0.apk
PUBLIC_APK_URL=
