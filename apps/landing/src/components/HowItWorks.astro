---
import { getCopy } from "../i18n";

interface Props {
  t: ReturnType<typeof getCopy>;
}

const { t } = Astro.props;
const steps = t.sectionHow.steps;
---

<section class="section" id="how-it-works">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2>{t.sectionHow.title}</h2>
      <p>{t.sectionHow.subtitle}</p>
    </div>

    <div class="steps">
      {
        Object.entries(steps).map(([key, step], index) => (
          <article
            class="card step"
            data-reveal
            style={`--reveal-delay:${index * 90}ms`}
          >
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
