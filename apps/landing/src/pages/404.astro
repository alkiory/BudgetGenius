---
import Base from "../layouts/Base.astro";
---

<Base
  lang="en"
  title="Page not found — BudgetGenius"
  description="The page you were looking for does not exist."
>
  <section class="section">
    <div class="container section-head center">
      <span class="eyebrow">404</span>
      <h1>This page took a different budget.</h1>
      <p>The link may be old, or the page may have moved into the app.</p>
      <p style="margin-top: 1.6rem;">
        <a class="btn btn-primary" href="/">Back to the home page</a>
      </p>
    </div>
  </section>
</Base>
