# 1. Builder
FROM node:22.22-bookworm-slim AS builder
WORKDIR /app

# Astro 7.4 requires Node >= 22.22; pnpm must match the root packageManager.
RUN npm install -g pnpm@12.23.0

# Copia de archivos base (desde la raíz del monorepo)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY apps/webClient/package.json ./apps/webClient/
COPY apps/landing/package.json ./apps/landing/

RUN pnpm install --frozen-lockfile

# Copiamos todo el monorepo
COPY . .

# Variables de entorno para el build (si es necesario)
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
ARG PUBLIC_APK_URL
ENV PUBLIC_APK_URL=$PUBLIC_APK_URL

# Limpiamos builds previos para evitar conflictos
RUN rm -rf apps/webClient/dist apps/landing/dist dist

# Landing (Astro, root) + SPA (Vite, /app/) → dist/
RUN pnpm build:web

# 2. Servidor Nginx
FROM nginx:stable-alpine

COPY apps/webClient/nginx.conf /etc/nginx/conf.d/default.conf

# Copia del build combinado
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
