#Resend email (password recovery)
# API key: https://resend.com/api-keys ("Sending access")
RESEND_API_KEY=
# Sender on a domain verified at https://resend.com/domains.
# The sandbox default (onboarding@resend.dev) only delivers to the Resend
# account owner's own address, so it cannot serve real password resets.
MAIL_FROM=BudgetGenius <no-reply@your-verified-domain>
# Log a counter milestone every N successful sends (default 25).
MAILER_COUNTER_MILESTONE=

