#DATABASE
DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
DB_NAME=
# DB_URL=
DB_SYNC=

#HOST
HOST=
FRONTEND_URL=
PORT=
NODE_ENV=
COOKIE_DOMAIN=

#Resend email (password recovery)
# API key: https://resend.com/api-keys ("Sending access")
RESEND_API_KEY=
# Sender on a domain verified at https://resend.com/domains.
# The sandbox default (onboarding@resend.dev) only delivers to the Resend
# account owner's own address, so it cannot serve real password resets.
MAIL_FROM=BudgetGenius <no-reply@your-verified-domain>
# Log a counter milestone every N successful sends (default 25).
MAILER_COUNTER_MILESTONE=

#JWT
JWT_SECRET=

##OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

#Firebase
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_DATABASE_URL=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

#Redis
REDIS_URL=
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=

#OpenAI
OPENAI_API_KEY=
OPENAI_PROJECT_ID=

#Finny — asistente financiero (llega al backend vía env_file de compose)
# Último recurso: las claves se gestionan en Backoffice → API keys → Claves
# de Finny. Esta variable solo se usa si no hay ninguna clave activa allí.
AGENT_API_KEY=

# Clave con la que se cifran las claves de Finny guardadas en la base de datos
# (AES-256-GCM). Si está vacía se usa JWT_SECRET; rotarla invalida las claves
# guardadas y hay que volver a introducirlas en el backoffice.
PROVIDER_KEYS_SECRET=

# Superadmin del backoffice. La contraseña solo se usa cuando la cuenta aún no
# existe: si el email ya está registrado, solo se le asigna el rol.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Directorio de las imágenes subidas desde el backoffice. Sin esta variable se
# usa <cwd>/uploads, que vive dentro del contenedor y se pierde al recrearlo.
UPLOAD_DIR=

#Github secrets
DOCKER_USERNAME=
DOCKER_PASSWORD=
SERVER_IP=
SERVER_USER=
SERVER_PASSWORD=
PUBLIC_API_URL=