DB_HOST=database
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_URL=

REDIS_HOST=redis
REDIS_URL=redis://redis:6379
# Required by docker-compose.prod.yml, which starts
# Redis with --requirepass and abort the `up` when it is missing.
# Generate one with: openssl rand -hex 24
REDIS_PASSWORD=
FRONTEND_URL=http://localhost:3001

# Superadmin backoffice. The account with this email is created (or promoted)
# to the `superadmin` role on boot. Leave both empty to skip it; in development
# a local fallback (superadmin@admin.com / #Password123) is seeded instead.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=