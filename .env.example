DB_HOST=database
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_URL=

REDIS_HOST=redis
REDIS_URL=redis://redis:6379
# Required by docker-compose.prod.yml / docker-compose.gce.yml, which start
# Redis with --requirepass and abort the `up` when it is missing.
# Generate one with: openssl rand -hex 24
REDIS_PASSWORD=
FRONTEND_URL=http://localhost:3001