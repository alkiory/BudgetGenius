{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "predeploy": [
      "pnpm build:web"
    ],
    "rewrites": [
      {
        "source": "/app/**",
        "destination": "/app/index.html"
      },
      {
        "source": "/auth/**",
        "destination": "/app/index.html"
      },
      {
        "source": "/privacy-policy",
        "destination": "/app/index.html"
      },
      {
        "source": "/terms-and-conditions",
        "destination": "/app/index.html"
      },
      {
        "source": "/contact-sales",
        "destination": "/app/index.html"
      },
      {
        "source": "/changelog",
        "destination": "/changelog/index.html"
      },
      {
        "source": "/es/changelog",
        "destination": "/es/changelog/index.html"
      }
    ]
  }
}